<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta: { title: 'Activate Pro | GetQuotationMaker', desc: 'Activate GetQuotationMaker Pro with the licence key from your Gumroad receipt.', path: '/activate', robots: 'noindex, follow' } }) %>
<style>
.act{max-width:520px;margin:40px auto;padding:0 16px}
.act-card{background:#fff;border:1px solid var(--border);border-radius:16px;padding:32px;box-shadow:0 4px 24px rgba(0,0,0,.05)}
.act-card h1{font:800 24px 'Sora',sans-serif;margin-bottom:8px}
.act-card p{color:#4b5563;font-size:14.5px;line-height:1.65;margin-bottom:14px}
.act-card label{display:block;font:700 11px 'Sora',sans-serif;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;margin:6px 0 6px}
.act-card input{width:100%;border:1px solid var(--border);border-radius:9px;padding:12px 14px;font:16px 'DM Sans',sans-serif;letter-spacing:.5px;margin-bottom:14px;text-transform:uppercase}
.act-card input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(15,76,129,.12)}
.act-card button{width:100%;padding:13px;background:var(--blue);border:none;border-radius:9px;color:#fff;font:700 15px 'Sora',sans-serif;cursor:pointer}
.act-card button:disabled{background:#93c5fd}
.act-card ul{margin:0 0 16px 20px;font-size:14px;color:#4b5563;line-height:1.7}
.msg{margin-top:14px;padding:12px 14px;border-radius:9px;font-size:14px;line-height:1.5}
.ok{background:#dcfce7;color:#166534}.err{background:#fee2e2;color:#b91c1c}
.help{font-size:13px;color:#6b7280;margin-top:18px;line-height:1.6}
.linkbtn{background:none!important;color:var(--blue)!important;border:1px solid var(--border)!important;margin-top:10px}
</style>
</head>
<body>
<%- include('partials/nav') %>
<main class="act">
  <div class="act-card">
  <% if (isPro) { %>
    <h1>Pro is active</h1>
    <p>Pro is active on this browser: no &ldquo;Made with&rdquo; line on your PDFs, your logo on quotes, and quote-to-invoice downloads.</p>
    <a class="btn" href="/#tool" style="width:100%;justify-content:center">Go to the quote maker</a>
    <button type="button" class="linkbtn" id="deact">Remove Pro from this browser</button>
  <% } else { %>
    <h1>Activate Pro</h1>
    <p>Paste the licence key from your Gumroad receipt email. It looks like <code>ABCD1234-EF567890-12AB34CD-56EF78AB</code>.</p>
    <ul>
      <li>No &ldquo;Made with GetQuotationMaker.com&rdquo; line on your PDFs</li>
      <li>Your logo on every quote</li>
      <li>Download any quote as a matching invoice</li>
    </ul>
    <form id="actForm" novalidate>
      <label for="key">Licence key</label>
      <input id="key" name="license_key" autocomplete="off" spellcheck="false" required placeholder="XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX">
      <button type="submit" id="actBtn">Activate Pro</button>
    </form>
    <div class="msg" id="msg" role="status" hidden></div>
    <p class="help">Don&rsquo;t have Pro yet? <a href="<%= gumroadLink %>" target="_blank" rel="noopener">Get it for $9, one-time</a>. Can&rsquo;t find your key? Open your Gumroad receipt or your Gumroad library. If the receipt has no key, reply to the receipt email and we will sort it out. You can use the same key on your other browsers and devices.</p>
  <% } %>
  </div>
</main>
<%- include('partials/footer') %>
<script>
(function () {
  var f = document.getElementById('actForm');
  if (f) f.addEventListener('submit', async function (e) {
    e.preventDefault();
    var key = document.getElementById('key').value.trim();
    var msg = document.getElementById('msg'), btn = document.getElementById('actBtn');
    if (!key) { msg.hidden = false; msg.className = 'msg err'; msg.textContent = 'Please paste your licence key.'; return; }
    btn.disabled = true; btn.textContent = 'Checking with Gumroad...';
    try {
      var r = await fetch('/activate-pro', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ license_key: key }) });
      var d = await r.json();
      msg.hidden = false;
      if (d.success) { msg.className = 'msg ok'; msg.textContent = 'Pro is active. Taking you to the quote maker...'; setTimeout(function () { location.href = '/#tool'; }, 1200); }
      else { msg.className = 'msg err'; msg.textContent = d.message || 'That key could not be verified.'; }
    } catch (err) { msg.hidden = false; msg.className = 'msg err'; msg.textContent = 'Network error. Please try again.'; }
    btn.disabled = false; btn.textContent = 'Activate Pro';
  });
  var d = document.getElementById('deact');
  if (d) d.addEventListener('click', async function () { await fetch('/deactivate-pro', { method: 'POST' }); location.reload(); });
})();
</script>
</body>
</html>
