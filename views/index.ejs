<%
var faqs = [
  ['Is this quotation maker really free?', 'Yes. You can make and download as many quotations as you like for free, with no account and no credit card. Free PDFs carry a small "Made with GetQuotationMaker.com" line at the bottom. Pro ($9, one-time) removes that line, adds your logo and lets you download any quote as a matching invoice.'],
  ['Do I need to sign up or log in?', 'No. The quotation maker runs in your browser. Your business name, email and address are remembered on this device so the next quote is faster; nothing is stored in an account.'],
  ['How do I make a quotation online?', 'Enter your details and your client’s, add a line for each item with a quantity and rate, set the tax rate, any discount and a valid-until date, add your terms, then press Download quote PDF. The live preview shows exactly what the PDF will look like.'],
  ['Can I use it on my phone?', 'Yes. The form and preview work on phones and tablets, and the PDF downloads straight to your device so you can attach it to an email or WhatsApp message.'],
  ['Which currencies and taxes are supported?', 'Over twenty currencies, including US dollars, pounds, euros, Indian rupees, Canadian, Australian and New Zealand dollars, rand, dirhams and more. Set any tax rate and name it VAT, GST, sales tax or anything else.'],
  ['What is the difference between a quote and an invoice?', 'A quote (or quotation) is sent before the work to tell the client what it will cost. Once they accept and the work is done, you send an invoice to request payment. With Pro you can download any quote as a matching invoice.'],
  ['Is Pro a subscription?', 'No. Pro is a one-time payment of $9 through Gumroad. After buying, enter the licence key from your Gumroad receipt on the Activate Pro page.']
];
%>
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta: {
  title: 'Free Online Quotation Maker: Create a Quote PDF, No Signup',
  ogTitle: 'Free Online Quotation Maker',
  desc: 'Free online quotation maker. Add line items, tax, discount and a validity date, see a live preview and download a professional quote PDF. No signup, works on mobile.',
  path: '/', tool: true,
  jsonld: [
    { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'GetQuotationMaker', alternateName: 'Free Online Quotation Maker', url: siteUrl + '/',
      description: 'Free online quotation maker that creates professional quote PDFs in the browser, with line items, tax, discounts and validity dates.',
      applicationCategory: 'BusinessApplication', operatingSystem: 'Any (web browser)', browserRequirements: 'Requires JavaScript',
      offers: [
        { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Pro (one-time payment)', price: '9.00', priceCurrency: 'USD', url: gumroadLink }
      ] },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(function (f) { return { '@type': 'Question', name: f[0], acceptedAnswer: { '@type': 'Answer', text: f[1] } }; }) }
  ] } }) %>
<meta name="google-site-verification" content="SRbRrdv1CAaGtpC67I5g5htAbMp2LmyqfylqDAKWvK0">
<style>
.steps{max-width:1000px;margin:0 auto;padding:44px 20px 10px}
.steps h2,.sec h2{font:800 25px 'Sora',sans-serif;letter-spacing:-.4px;text-align:center;margin-bottom:8px;color:var(--dark)}
.sub{text-align:center;color:var(--muted);font-size:15px;margin:0 auto 26px;max-width:620px;line-height:1.6}
.step-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.step{background:#fff;border:1px solid var(--border);border-radius:12px;padding:18px}
.step b{display:inline-flex;width:28px;height:28px;border-radius:50%;background:var(--blue);color:#fff;align-items:center;justify-content:center;font:800 13px 'Sora',sans-serif;margin-bottom:10px}
.step h3{font-size:15px;margin-bottom:5px}
.step p{font-size:13.5px;color:var(--muted);line-height:1.6}
.sec{padding:48px 20px;border-top:1px solid var(--border)}
.sec.white{background:#fff}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:960px;margin:0 auto}
.feat{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px}
.white .feat{background:#fbfcfe}
.feat h3{font-size:15px;margin-bottom:6px}
.feat p{font-size:13.5px;color:var(--muted);line-height:1.6}
.plans{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:680px;margin:0 auto}
.plan{border:1px solid var(--border);border-radius:14px;padding:24px;background:#fff;position:relative}
.plan.pop{border:2px solid var(--blue)}
.pname{font:700 11px 'Sora',sans-serif;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px}
.pprice{font:800 38px/1 'Sora',sans-serif;color:var(--dark)}
.pper{font-size:13px;color:var(--muted);margin:6px 0 18px}
.plan ul{list-style:none;margin:0 0 20px;display:grid;gap:8px}
.plan li{font-size:14px;color:#334155;padding-left:22px;position:relative;line-height:1.5}
.plan li::before{content:'';position:absolute;left:2px;top:6px;width:10px;height:6px;border-left:2px solid #16a34a;border-bottom:2px solid #16a34a;transform:rotate(-45deg)}
.plan .btn{width:100%;justify-content:center}
.objections{max-width:680px;margin:18px auto 0;display:grid;gap:8px;font-size:13.5px;color:#4b5563;line-height:1.6}
.objections p{background:#fff;border:1px solid var(--border);border-radius:10px;padding:10px 14px}
.cmp{max-width:680px;margin:22px auto 0;width:100%;border-collapse:collapse;background:#fff;font-size:14px;border:1px solid var(--border);border-radius:12px;overflow:hidden}
.cmp th,.cmp td{padding:10px 14px;border-bottom:1px solid #f1f3f6;text-align:left}
.cmp th{background:#f8fafc;font:700 11px 'Sora',sans-serif;text-transform:uppercase;letter-spacing:.5px;color:var(--muted)}
.cmp td:not(:first-child),.cmp th:not(:first-child){text-align:center;width:110px}
.y{color:#15803d;font-weight:700}.n0{color:#9ca3af}
.invoice-cta{background:linear-gradient(135deg,#0f4c81 0%,#1a6aad 100%);padding:44px 20px;text-align:center;color:#fff}
.invoice-cta h2{font:800 22px 'Sora',sans-serif;margin-bottom:8px}
.invoice-cta p{color:rgba(255,255,255,.85);font-size:14px;margin-bottom:18px}
.invoice-cta a{display:inline-block;background:#fff;color:var(--blue);padding:11px 24px;border-radius:8px;font:700 14px 'Sora',sans-serif}
@media (max-width:860px){.step-grid{grid-template-columns:1fr 1fr}.feat-grid{grid-template-columns:1fr 1fr}}
@media (max-width:600px){.cmp th,.cmp td{padding:9px 8px;font-size:13px}.cmp td:not(:first-child),.cmp th:not(:first-child){width:64px}.step-grid,.feat-grid,.plans{grid-template-columns:1fr}.steps h2,.sec h2{font-size:22px}.sec{padding:38px 16px}}
</style>
</head>
<body>
<%- include('partials/nav') %>

<header class="hero">
  <div class="badge">Free PDF download, no signup</div>
  <h1>Free online quotation maker</h1>
  <p class="lead">Make a professional quotation in your browser: add line items, tax, a discount and a validity date, watch the preview update, then download a clean PDF to send to your client. No account, no login, works on your phone.</p>
  <div class="btn-row">
    <a class="btn" href="#tool">Start your quotation</a>
    <a class="btn ghost" href="#templates">Browse quote templates</a>
  </div>
  <div class="trust"><span>Free PDF download</span><span>No signup</span><span>Tax, discount and validity date</span><span>20+ currencies</span></div>
</header>

<div id="tool"></div>
<%- include('partials/tool', { tool: tool }) %>

<section class="steps" aria-labelledby="how-h">
  <h2 id="how-h">How to make a quotation online</h2>
  <p class="sub">Four steps, about a minute for a simple quote.</p>
  <div class="step-grid">
    <div class="step"><b>1</b><h3>Add your details</h3><p>Your business name, contact details and address. They are remembered on this device for next time.</p></div>
    <div class="step"><b>2</b><h3>Add the client and items</h3><p>One line per item or task, with a quantity and rate. Or start from an example for your trade.</p></div>
    <div class="step"><b>3</b><h3>Set tax, discount and terms</h3><p>VAT, GST or sales tax, an optional discount, a valid-until date, and your payment terms in the notes.</p></div>
    <div class="step"><b>4</b><h3>Download and send</h3><p>Download the PDF and email it with one of our <a href="/how-to-send-a-quote-to-a-client">quote email templates</a>.</p></div>
  </div>
</section>

<section class="sec" id="features" aria-labelledby="feat-h">
  <h2 id="feat-h">What the quotation maker does</h2>
  <p class="sub">Everything a client needs to say yes, on one page.</p>
  <div class="feat-grid">
    <div class="feat"><h3>Live preview</h3><p>The quote updates as you type, so the PDF looks exactly like the preview.</p></div>
    <div class="feat"><h3>Line items and totals</h3><p>Quantities, rates, subtotal, a fixed or percentage discount and a tax line are calculated for you.</p></div>
    <div class="feat"><h3>Validity date</h3><p>A valid-until date is printed on the quote, so clients know how long the price holds.</p></div>
    <div class="feat"><h3>Any currency</h3><p>Dollars, pounds, euros, rupees, rand, dirhams and more, with the right symbol on the PDF.</p></div>
    <div class="feat"><h3>Trade examples</h3><p>Load a ready-made example for tradespeople, painters, mechanics, consultants and more, then edit it.</p></div>
    <div class="feat"><h3>Works on mobile</h3><p>Fill in and download quotes from your phone on site, then attach the PDF to an email.</p></div>
  </div>
</section>

<section class="sec white" id="pricing" aria-labelledby="price-h">
  <h2 id="price-h">Free, with an optional one-time Pro</h2>
  <p class="sub">The quotation maker is free for unlimited quotes. Pro is a single $9 payment, not a subscription.</p>
  <div class="plans">
    <div class="plan">
      <div class="pname">Free</div>
      <div class="pprice">$0</div>
      <div class="pper">No account, no card</div>
      <ul>
        <li>Unlimited quotes and PDF downloads</li>
        <li>All currencies, tax and discounts</li>
        <li>Validity dates, notes and terms</li>
        <li>Trade examples to start from</li>
        <li>Small &ldquo;Made with GetQuotationMaker.com&rdquo; line on the PDF</li>
      </ul>
      <a class="btn ghost" href="#tool">Make a free quote</a>
    </div>
    <div class="plan pop">
      <div class="pname">Pro</div>
      <div class="pprice">$9</div>
      <div class="pper">One-time payment via Gumroad</div>
      <ul>
        <li>Everything in Free</li>
        <li>No &ldquo;Made with&rdquo; line on your PDFs</li>
        <li>Your logo on every quote</li>
        <li>Download any quote as a matching invoice PDF</li>
      </ul>
      <% if (isPro) { %><span class="btn" style="background:#15803d;border-color:#15803d">Pro is active on this browser</span><% } else { %><a class="btn" href="<%= gumroadLink %>" target="_blank" rel="noopener">Get Pro for $9</a><% } %>
    </div>
  </div>
  <table class="cmp">
    <thead><tr><th>Feature</th><th>Free</th><th>Pro</th></tr></thead>
    <tbody>
      <tr><td>Quotes and PDF downloads</td><td class="y">Unlimited</td><td class="y">Unlimited</td></tr>
      <tr><td>Currencies, tax, discount, validity date</td><td class="y">Yes</td><td class="y">Yes</td></tr>
      <tr><td>&ldquo;Made with GetQuotationMaker.com&rdquo; line</td><td>Shown</td><td class="y">Removed</td></tr>
      <tr><td>Your logo on the PDF</td><td class="n0">No</td><td class="y">Yes</td></tr>
      <tr><td>Quote to invoice PDF</td><td class="n0">No</td><td class="y">Yes</td></tr>
    </tbody>
  </table>
  <div class="objections">
    <p><strong>Is it a subscription?</strong> No. You pay $9 once on Gumroad and keep Pro.</p>
    <p><strong>How do I turn it on?</strong> Gumroad emails you a licence key. Paste it on the <a href="/activate">Activate Pro</a> page; you can use the same key on your other browsers.</p>
    <p><strong>Do I need Pro?</strong> Not to make and send quotes. Free quotes are complete and professional; Pro is for removing the credit line, adding your logo and invoicing from the same data.</p>
  </div>
</section>

<section class="faq" aria-labelledby="faq-h" style="padding-top:44px">
  <h2 id="faq-h">Frequently asked questions</h2>
  <% faqs.forEach(function (f) { %><details><summary><%= f[0] %></summary><p><%= f[1] %></p></details><% }) %>
</section>

<section class="links-sec" id="templates">
  <h2>Free quote templates by trade</h2>
  <div class="sgrid">
    <% professions.forEach(function (p) { %><a href="<%= p.path %>" class="sl"><%= p.label %></a><% }) %>
  </div>
  <h2>Quote generators by country</h2>
  <div class="sgrid">
    <% countries.forEach(function (c) { %><a href="/free-quote-generator-<%= c.slug %>" class="sl"><%= c.fullName %> (<%= c.currency %>)</a><% }) %>
  </div>
  <h2>Guides and email templates</h2>
  <div class="sgrid">
    <% guides.forEach(function (g) { %><a href="<%= g[0] %>" class="sl"><%= g[1] %></a><% }) %>
  </div>
</section>

<section class="invoice-cta">
  <h2>Quote accepted? Send the invoice.</h2>
  <p>Create a matching invoice for free with our sister tool. No signup.</p>
  <a href="https://getinvoicemaker.com/" target="_blank" rel="noopener">Open GetInvoiceMaker</a>
</section>

<%- include('partials/footer') %>
</body>
</html>
