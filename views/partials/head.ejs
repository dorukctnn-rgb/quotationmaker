<%
  var m = meta || {};
  var base = (typeof siteUrl !== 'undefined' && siteUrl) || 'https://www.getquotationmaker.com';
  var url = base + (m.path || '/');
  var v = (typeof assetVersion !== 'undefined' && assetVersion) || '1';
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= m.title %></title>
<meta name="description" content="<%= m.desc %>">
<% if (m.robots) { %><meta name="robots" content="<%= m.robots %>"><% } else { %><link rel="canonical" href="<%= url %>"><% } %>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:site_name" content="GetQuotationMaker">
<meta property="og:type" content="<%= m.type || 'website' %>">
<meta property="og:title" content="<%= m.ogTitle || m.title %>">
<meta property="og:description" content="<%= m.desc %>">
<meta property="og:url" content="<%= url %>">
<meta property="og:image" content="<%= base %>/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= m.ogTitle || m.title %>">
<meta name="twitter:description" content="<%= m.desc %>">
<meta name="twitter:image" content="<%= base %>/og-image.png">
<meta name="theme-color" content="#ffffff">
<link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin>
<style>
@font-face{font-family:'DM Sans';font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/dm-sans-latin-ext.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'DM Sans';font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/dm-sans-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Sora';font-style:normal;font-weight:600 800;font-display:swap;src:url(/fonts/sora-latin-ext.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Sora';font-style:normal;font-weight:600 800;font-display:swap;src:url(/fonts/sora-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
</style>
<link rel="stylesheet" href="/site.css?v=<%= v %>"><% if (typeof countOn !== 'undefined' && countOn) { %><script src="/count.js?v=<%= typeof countVersion !== 'undefined' ? countVersion : '1' %>" defer></script><% } %>
<% if (m.tool) { %><link rel="stylesheet" href="/tool.css?v=<%= v %>"><% } %>
<% (m.jsonld || []).forEach(function (obj) { %>
<script type="application/ld+json"><%- JSON.stringify(obj).replace(/</g, '\\u003c') %></script>
<% }) %>
<script>
document.addEventListener('DOMContentLoaded',function(){
  var nav=document.querySelector('.site-nav'),links=nav&&nav.querySelector('.nav-r');
  if(!links)return;
  var b=document.createElement('button');
  b.className='nav-toggle';b.type='button';b.setAttribute('aria-expanded','false');b.setAttribute('aria-label','Open menu');
  b.innerHTML='<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Menu';
  b.addEventListener('click',function(){var o=nav.classList.toggle('nav-open');b.setAttribute('aria-expanded',o);});
  nav.insertBefore(b,links);
});
</script>
