<%
var c = country;
var path = '/free-quote-generator-' + c.slug;
%>
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta: {
  title: c.title, desc: c.desc, path: path, tool: true,
  jsonld: [
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Quote generators by country', item: siteUrl + '/#templates' },
      { '@type': 'ListItem', position: 3, name: c.fullName, item: siteUrl + path } ] }
  ] } }) %>
</head>
<body>
<%- include('partials/nav') %>
<div class="breadcrumb"><a href="/">Home</a> &rsaquo; <a href="/#templates">By country</a> &rsaquo; <%= c.fullName %></div>

<header class="hero">
  <div class="badge"><%= c.currency %> &middot; <%= c.tax %> <%= c.taxRate %>% pre-filled &middot; Free PDF</div>
  <h1><%= c.h1 %></h1>
  <p class="lead"><%= c.lead %></p>
  <div class="btn-row"><a class="btn" href="#qtTool">Start your quote</a><a class="btn ghost" href="#facts"><%= c.tax %> and quote rules</a></div>
</header>

<%- include('partials/tool', { tool: tool }) %>

<main class="article">
  <div class="prose">
    <h2 id="facts"><%= c.tax %> and quoting in <%= c.fullName %></h2>
    <p>Local name for the document: <strong><%= c.docName %></strong>. The quote maker starts with <%= c.currency %> and <%= c.tax %> at <%= c.taxRate %>%. Change the rate if a different one applies to your work, or set it to 0 if you are not registered.</p>
    <table class="facts">
      <thead><tr><th>Rule</th><th>What it says</th><th>Official source</th></tr></thead>
      <tbody>
        <% c.facts.forEach(function (f) { %><tr><td><strong><%= f[0] %></strong></td><td><%= f[1] %></td><td><%- f[2] %></td></tr><% }) %>
      </tbody>
    </table>
    <p class="src">Last checked <%= factsChecked %>. Tax rules change and can depend on what you sell; check with the tax authority or an accountant for your situation.</p>
    <%- c.tips %>
    <h2>What to include on your quote</h2>
    <ul>
      <li>Your business name, address and contact details, and your tax or registration number if you have one</li>
      <li>The client&rsquo;s name and address</li>
      <li>A unique quote number, the date and a valid-until date</li>
      <li>Itemised work or goods with quantities and rates in <%= c.currency %></li>
      <li><%= c.tax %> as a separate line, and the total including <%= c.tax %></li>
      <li>Payment terms, exclusions and how the client accepts</li>
    </ul>
    <p>Then send it with one of our <a href="/how-to-send-a-quote-to-a-client">quote email templates</a>.</p>
  </div>
</main>

<section class="links-sec">
  <h2>Quote generators for other countries</h2>
  <div class="sgrid">
    <% countries.filter(function (o) { return o.slug !== c.slug; }).forEach(function (o) { %><a href="/free-quote-generator-<%= o.slug %>" class="sl"><%= o.fullName %> (<%= o.currency %>)</a><% }) %>
    <a href="/" class="sl">United States and other countries</a>
  </div>
  <h2>Free quote templates by trade</h2>
  <div class="sgrid">
    <% professions.slice(0, 10).forEach(function (o) { %><a href="<%= o.path %>" class="sl"><%= o.label %></a><% }) %>
  </div>
</section>
<%- include('partials/footer') %>
</body>
</html>
