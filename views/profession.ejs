<%
var p = profession;
var lower = p.name.toLowerCase();
var faq = p.faq || [
  { q: 'What should a ' + lower + ' quote include?', a: 'Your business name and contact details, the client’s name and address, a unique quote number and date, a valid-until date, an itemised list of the work with quantities and rates, any tax such as VAT, GST or sales tax, the total, and your payment terms and exclusions.' },
  { q: 'How do I price a ' + lower + ' quote?', a: 'Work out your costs (materials or expenses, and your time at a rate that covers overheads), add a profit margin, then list the work as clear line items so the client can see what they are paying for. State what the price does not include.' },
  { q: 'Is a quote legally binding?', a: 'A quote is an offer. Once the client accepts it, it normally becomes the agreement for that work at that price, which is why the scope, exclusions and validity date matter. Rules vary by country.' },
  { q: 'How long should a quote stay valid?', a: 'Thirty days is common. Use a shorter period if your costs change quickly, and write the actual date on the quote.' }
];
var crumbs = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
  { '@type': 'ListItem', position: 2, name: 'Quote templates', item: siteUrl + '/#templates' },
  { '@type': 'ListItem', position: 3, name: p.name + ' quote template', item: siteUrl + p.path }
];
%>
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta: {
  title: p.title, desc: p.desc, path: p.path, tool: true,
  jsonld: [
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(function (f) { return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }; }) }
  ] } }) %>
</head>
<body>
<%- include('partials/nav') %>
<div class="breadcrumb"><a href="/">Home</a> &rsaquo; <a href="/#templates">Quote templates</a> &rsaquo; <%= p.name %></div>

<header class="hero">
  <% if (p.badge) { %><div class="badge"><%= p.badge %></div><% } %>
  <h1><%= p.h1 %></h1>
  <p class="lead"><%= p.lead %></p>
  <div class="btn-row">
    <% if (p.heroCta) { %><a class="btn" href="#qtTool" data-preset="<%= p.heroCta.preset %>"><%= p.heroCta.label %></a><% } else { %><a class="btn" href="#qtTool">Fill in the template online</a><% } %>
    <% if (p.downloads) { %><a class="btn ghost" href="#downloads">Download Word, Excel or PDF</a><% } %>
  </div>
  <div class="trust"><span>Free PDF download</span><span>No signup</span><span>Tax and discount lines</span><span>Validity date</span></div>
  <% if (p.updated) { %><p class="meta">Updated <%= new Date(p.updated + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) %></p><% } %>
</header>

<% if (p.downloads) { %>
<section class="dl-wrap" id="downloads" aria-labelledby="dl-h">
  <h2 id="dl-h">Download the free <%= lower %> quote template</h2>
  <p>Editable in Word, Google Docs, Excel or Google Sheets, or print the PDF and fill it in by hand. No signup.</p>
  <div class="dl-grid">
    <% p.downloads.forEach(function (d) { %>
    <div class="dl-card">
      <h3><%= d.title %></h3>
      <p><%= d.desc %></p>
      <div class="dl-links">
        <% d.files.forEach(function (f) { var ext = f[0].split('.').pop(); %><a href="<%= f[0] %>" download class="<%= ext === 'xlsx' ? 'x' : (ext === 'pdf' ? 'p' : '') %>"><b><%= ext.toUpperCase() %></b><%= f[1] %></a><% }) %>
        <% if (d.preset) { %><button type="button" data-preset="<%= d.preset %>">Fill in online</button><% } %>
      </div>
    </div>
    <% }) %>
  </div>
</section>
<% } %>

<%- include('partials/tool', { tool: tool }) %>

<main class="article">
  <div class="prose">
    <% if (!p.downloads) { %>
    <h2>What to include in a <%= lower %> quote</h2>
    <ul>
      <li>Your business name, address and contact details</li>
      <li>The client&rsquo;s name and the job or delivery address</li>
      <li>A unique quote number and the date</li>
      <li>A valid-until date, so the client knows how long the price holds</li>
      <li>An itemised list of the work, with quantities and rates</li>
      <li>Tax (VAT, GST or sales tax) if you are registered</li>
      <li>The total, payment terms and what is not included</li>
    </ul>
    <% } %>
    <%- p.guide %>
    <% if (!p.downloads) { %>
    <h2>How to use this <%= lower %> quote template</h2>
    <p>Press the example button above the form to load a sample <%= lower %> quote, then replace the details with your own. The preview updates as you type. When it looks right, press <strong>Download quote PDF</strong> and send it to your client with one of our <a href="/how-to-send-a-quote-to-a-client">quote email templates</a>.</p>
    <% } %>
  </div>
</main>

<section class="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">Frequently asked questions</h2>
  <% faq.forEach(function (f) { %><details><summary><%= f.q %></summary><p><%= f.a %></p></details><% }) %>
</section>

<section class="links-sec">
  <h2>Guides</h2>
  <div class="sgrid">
    <a class="sl" href="/how-to-send-a-quote-to-a-client">How to send a quote by email</a>
    <a class="sl" href="/quote-acceptance-template">Quote acceptance wording</a>
    <a class="sl" href="/blog/how-to-price-a-job-quote">How to price a job quote</a>
    <a class="sl" href="/blog/vat-on-quotes-explained">VAT on quotes</a>
  </div>
  <h2>Other free quote templates</h2>
  <div class="sgrid">
    <% professions.filter(function (o) { return o.slug !== p.slug; }).forEach(function (o) { %><a href="<%= o.path %>" class="sl"><%= o.label %></a><% }) %>
  </div>
</section>
<%- include('partials/footer') %>
</body>
</html>
