<!DOCTYPE html>
<html lang="en">
<head>
<%
  var jsonld = [
    { '@context': 'https://schema.org', '@type': 'Article', headline: post.h1, description: post.desc, datePublished: post.date, dateModified: post.updated,
      mainEntityOfPage: siteUrl + '/blog/' + post.slug, image: siteUrl + '/og-image.png',
      author: { '@type': 'Organization', name: 'GetQuotationMaker', url: siteUrl + '/' }, publisher: { '@type': 'Organization', name: 'GetQuotationMaker', url: siteUrl + '/' } },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: siteUrl + '/blog' },
      { '@type': 'ListItem', position: 3, name: post.h1, item: siteUrl + '/blog/' + post.slug } ] }
  ];
  if (post.faq && post.faq.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: post.faq.map(function (f) { return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }; }) });
  var cta = post.cta || { title: 'Create a professional quote now', text: 'Free quotation maker: line items, tax, discount and a validity date, downloaded as a PDF. No signup.', href: '/#tool', label: 'Open the quote maker' };
%>
<%- include('partials/head', { meta: { title: post.title, desc: post.desc, path: '/blog/' + post.slug, type: 'article', jsonld: jsonld } }) %>
<style>
.post-head{max-width:760px;margin:0 auto;padding:40px 20px 0}
.tag{font:700 11px 'Sora',sans-serif;color:var(--blue);text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px}
.post-head h1{font:800 clamp(26px,4vw,36px)/1.2 'Sora',sans-serif;letter-spacing:-.5px;margin-bottom:10px;color:var(--dark)}
.post-meta{font-size:13px;color:#8b95a5;display:flex;gap:14px;flex-wrap:wrap}
.rel-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px}
.rel-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:14px;display:block}
.rel-card:hover{border-color:var(--blue);text-decoration:none}
.rel-card span{font:700 10px 'Sora',sans-serif;color:var(--blue);text-transform:uppercase;letter-spacing:.5px}
.rel-card strong{display:block;font:700 14px/1.4 'Sora',sans-serif;color:var(--text);margin-top:4px}
@media (max-width:640px){.rel-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<%- include('partials/nav') %>
<div class="breadcrumb"><a href="/">Home</a> &rsaquo; <a href="/blog">Guides</a> &rsaquo; <%= post.h1 %></div>
<div class="post-head">
  <div class="tag"><%= post.category %></div>
  <h1><%= post.h1 %></h1>
  <div class="post-meta"><span>Updated <%= new Date(post.updated + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) %></span><span><%= post.readTime %></span></div>
</div>
<main class="article">
  <% if (post.answer) { %><div class="answer prose"><%- post.answer %></div><% } %>
  <% if (post.toc && post.toc.length) { %>
  <nav class="toc" aria-label="On this page"><strong>On this page</strong>
    <ol><% post.toc.forEach(function (t) { %><li><a href="#<%= t[0] %>"><%= t[1] %></a></li><% }) %></ol>
  </nav>
  <% } %>
  <article class="prose"><%- post.content %></article>
  <div class="cta-box">
    <h2><%= cta.title %></h2>
    <p><%= cta.text %></p>
    <a href="<%= cta.href %>"><%= cta.label %></a>
  </div>
</main>
<% if (post.faq && post.faq.length) { %>
<section class="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">Questions</h2>
  <% post.faq.forEach(function (f) { %>
  <details><summary><%= f.q %></summary><p><%= f.a %></p></details>
  <% }) %>
</section>
<% } %>
<div class="article" style="padding-top:0">
  <h2 style="font:800 19px 'Sora',sans-serif;margin-top:10px">Related guides</h2>
  <div class="rel-grid">
    <% relatedPosts.forEach(function (p) { %><a href="<%= p.href %>" class="rel-card"><span><%= p.tag %></span><strong><%= p.title %></strong></a><% }) %>
  </div>
</div>
<%- include('partials/footer') %>
<% if (post.script) { %><script src="<%= post.script %>?v=<%= assetVersion %>" defer></script><% } %>
</body>
</html>
