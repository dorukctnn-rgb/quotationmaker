<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta: {
  title: page.title, desc: page.desc, path: '/' + page.slug, type: 'article', tool: !!tool,
  jsonld: [
    { '@context': 'https://schema.org', '@type': 'Article', headline: page.h1, description: page.desc, dateModified: page.updated, mainEntityOfPage: siteUrl + '/' + page.slug, image: siteUrl + '/og-image.png',
      author: { '@type': 'Organization', name: 'GetQuotationMaker', url: siteUrl + '/' }, publisher: { '@type': 'Organization', name: 'GetQuotationMaker', url: siteUrl + '/' } },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: siteUrl + '/blog' },
      { '@type': 'ListItem', position: 3, name: page.h1, item: siteUrl + '/' + page.slug } ] }
  ] } }) %>
</head>
<body>
<%- include('partials/nav') %>
<div class="breadcrumb"><a href="/">Home</a> &rsaquo; <a href="/blog">Guides</a> &rsaquo; <%= page.h1 %></div>

<header class="hero">
  <h1><%= page.h1 %></h1>
  <p class="lead"><%= page.desc %></p>
  <div class="btn-row"><a class="btn" href="<%= tool ? '#qtTool' : '/#tool' %>"><%= tool ? 'Open the example in the quote maker' : 'Create a free quote' %></a></div>
  <p class="meta">Updated <%= new Date(page.updated + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) %></p>
</header>

<main class="article">
  <article class="prose"><%- page.content %></article>
</main>

<% if (tool) { %><%- include('partials/tool', { tool: tool }) %><% } else { %>
<div class="article" style="padding-top:0"><div class="cta-box"><h2>Create a quote in a minute</h2><p>Free quotation maker with line items, tax, discount and a validity date. No signup.</p><a href="/#tool">Open the quote maker &rarr;</a></div></div>
<% } %>

<section class="links-sec">
  <h2>Related</h2>
  <div class="sgrid">
    <a class="sl" href="/how-to-send-a-quote-to-a-client">How to send a quote by email</a>
    <a class="sl" href="/quote-acceptance-template">Quote acceptance wording</a>
    <a class="sl" href="/quote-template-contractor">Contractor &amp; tradesman quote template</a>
    <a class="sl" href="/quote-template-builder">Builder quote template</a>
    <a class="sl" href="/blog/quote-vs-invoice-difference">Quote vs invoice</a>
  </div>
</section>
<%- include('partials/footer') %>
<% if (!tool) { %><script src="/tool.js?v=<%= assetVersion %>" defer></script><% } %>
</body>
</html>
