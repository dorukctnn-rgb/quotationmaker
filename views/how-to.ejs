<!DOCTYPE html>
<html lang="en">
<head>
<%
  var jsonld = [
    { '@context': 'https://schema.org', '@type': 'Article', headline: page.h1, description: page.desc, datePublished: page.published || page.updated, dateModified: page.updated, mainEntityOfPage: siteUrl + '/' + page.slug, image: siteUrl + '/og-image.png',
      author: { '@type': 'Organization', name: 'GetQuotationMaker', url: siteUrl + '/' }, publisher: { '@type': 'Organization', name: 'GetQuotationMaker', url: siteUrl + '/' } },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: siteUrl + '/blog' },
      { '@type': 'ListItem', position: 3, name: page.h1, item: siteUrl + '/' + page.slug } ] }
  ];
  if (page.faq && page.faq.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: page.faq.map(function (f) { return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }; }) });
  var related = page.related || [
    ['/how-to-send-a-quote-to-a-client', 'How to send a quote by email'],
    ['/quote-acceptance-template', 'Quote acceptance wording'],
    ['/quote-template-contractor', 'Contractor &amp; tradesman quote template'],
    ['/quote-template-builder', 'Builder quote template'],
    ['/how-to-convert-a-quote-to-an-invoice', 'Turn an accepted quote into an invoice']
  ];
%>
<%- include('partials/head', { meta: { title: page.title, desc: page.desc, path: '/' + page.slug, type: 'article', tool: !!tool, jsonld: jsonld } }) %>
</head>
<body>
<%- include('partials/nav') %>
<div class="breadcrumb"><a href="/">Home</a> &rsaquo; <a href="/blog">Guides</a> &rsaquo; <%= page.breadcrumb || page.h1 %></div>

<header class="hero">
  <h1><%= page.h1 %></h1>
  <p class="lead"><%= page.lead || page.desc %></p>
  <div class="btn-row">
    <% if (page.jump) { %><a class="btn" href="#<%= page.jump[0] %>"><%= page.jump[1] %></a><% } %>
    <a class="btn<%= page.jump ? ' ghost' : '' %>" href="<%= tool ? '#qtTool' : '/#tool' %>"><%= page.heroLabel || (tool ? 'Open the example in the quote maker' : 'Create a free quote') %></a>
  </div>
  <p class="meta">Updated <%= new Date(page.updated + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) %></p>
</header>

<main class="article">
  <% if (page.answer) { %><div class="answer prose"><%- page.answer %></div><% } %>
  <% if (page.toc && page.toc.length) { %>
  <nav class="toc" aria-label="On this page"><strong>On this page</strong>
    <ol><% page.toc.forEach(function (t) { %><li><a href="#<%= t[0] %>"><%= t[1] %></a></li><% }) %></ol>
  </nav>
  <% } %>
  <article class="prose"><%- page.content %></article>
</main>

<% if (tool) { %><%- include('partials/tool', { tool: tool }) %><% } else { %>
<div class="article" style="padding-top:0"><div class="cta-box"><h2>Create a quote in a minute</h2><p>Free quotation maker with line items, tax, discount and a validity date. No signup.</p><a href="/#tool">Open the quote maker</a></div></div>
<% } %>

<% if (page.faq && page.faq.length) { %>
<section class="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">Questions</h2>
  <% page.faq.forEach(function (f) { %>
  <details><summary><%= f.q %></summary><p><%= f.a %></p></details>
  <% }) %>
</section>
<% } %>

<section class="links-sec">
  <h2>Related</h2>
  <div class="sgrid">
    <% related.forEach(function (r) { %><a class="sl" href="<%= r[0] %>"><%- r[1] %></a><% }) %>
  </div>
</section>
<%- include('partials/footer') %>
<% if (!tool) { %><script src="/tool.js?v=<%= assetVersion %>" defer></script><% } %>
</body>
</html>
