<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta: {
  title: 'Quoting Guides, Email Templates and How-Tos | GetQuotationMaker',
  desc: 'Free guides for writing, pricing, sending and following up on quotes: quote email templates, acceptance wording, VAT on quotes and trade-specific how-tos.',
  path: '/blog'
} }) %>
<style>
.wrap{max-width:1000px;margin:0 auto;padding:30px 20px 40px}
.sec-title{font:800 20px 'Sora',sans-serif;letter-spacing:-.3px;margin:26px 0 14px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:18px;display:block;color:inherit}
.card:hover{border-color:var(--blue);text-decoration:none}
.card .tag{font:700 10px 'Sora',sans-serif;color:var(--blue);text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px}
.card h2,.card h3{font:700 15px/1.4 'Sora',sans-serif;color:var(--text);margin-bottom:8px}
.card p{font-size:13.5px;color:var(--muted);line-height:1.6}
@media (max-width:860px){.grid{grid-template-columns:1fr 1fr}}
@media (max-width:600px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<%- include('partials/nav') %>
<header class="hero">
  <h1>Quoting guides and templates</h1>
  <p class="lead">Practical guides for freelancers, tradespeople and small businesses: write a clear quote, price it, send it, follow it up and get it accepted.</p>
  <div class="btn-row"><a class="btn" href="/#tool">Create a free quote</a></div>
</header>
<main class="wrap">
  <div class="sec-title">Templates to copy</div>
  <div class="grid">
    <% guides.forEach(function (g) { %><a class="card" href="/<%= g.slug %>"><div class="tag">Templates</div><h2><%= g.h1 %></h2><p><%= g.desc %></p></a><% }) %>
  </div>
  <div class="sec-title">Guides</div>
  <div class="grid">
    <% posts.forEach(function (p) { %><a class="card" href="/blog/<%= p.slug %>"><div class="tag"><%= p.category %></div><h2><%= p.h1 %></h2><p><%= p.desc %></p></a><% }) %>
  </div>
  <div class="sec-title">How-to guides</div>
  <div class="grid">
    <% howTo.forEach(function (p) { %><a class="card" href="/<%= p.slug %>"><div class="tag">How-to</div><h3><%= p.h1 %></h3><p><%= p.desc %></p></a><% }) %>
  </div>
</main>
<%- include('partials/footer') %>
</body>
</html>
